# ==============================================================================
# Akıllı Saha CRM - Çevre Değişkenleri Şablonu (.env.example)
# 12-Factor App Uyumlu: Hiçbir gizli bilgi veya şifre kodda tutulmaz.
# Bu dosyayı '.env' olarak kopyalayıp kendi ortamınıza göre doldurabilirsiniz.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Ortam ve Profil Ayarları
# ------------------------------------------------------------------------------
# Yerel testler için 'default', Render / Supabase canlı için 'prod'
SPRING_PROFILES_ACTIVE=prod
PORT=8080

# ------------------------------------------------------------------------------
# 2. Veritabanı Ayarları (Supabase PostgreSQL / Azure)
# ------------------------------------------------------------------------------
# Supabase Free Tier için Connection Pooler (Port 6543) veya Doğrudan (Port 5432)
# Örnek: jdbc:postgresql://aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require
DB_URL=jdbc:postgresql://db.supabase.co:5432/postgres?sslmode=require
DB_USER=postgres.proje_referans_kodunuz
DB_PASSWORD=supabase_guclu_veritabani_sifreniz

# HikariCP Havuz Boyutu (Supabase Free Tier için 5 önerilir)
DB_POOL_MAX=5
DB_POOL_MIN=1

# ------------------------------------------------------------------------------
# 3. Güvenlik & JWT (JSON Web Token)
# ------------------------------------------------------------------------------
# En az 256-bit (64 hex karakter) uzunluğunda rastgele üretilmiş gizli anahtar
# Üretmek için terminalden: openssl rand -hex 32
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# 4. CORS ve Frontend Entegrasyonu
# ------------------------------------------------------------------------------
# Frontend SPA uygulamasının erişim adresleri (virgülle ayrılmış)
FRONTEND_URL=https://akilli-saha-crm.vercel.app,http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 5. Katman 9: UptimeRobot & Health Check
# ------------------------------------------------------------------------------
# UptimeRobot URL'si: https://<render-servis-adiniz>.onrender.com/actuator/health
# Aralık: 5 dakika (Render'ın 15 dakikalık spin-down uyku modunu engeller)
