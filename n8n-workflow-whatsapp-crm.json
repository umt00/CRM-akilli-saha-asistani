{
  "name": "WhatsApp - Akıllı Saha CRM Saha Notu Entegrasyonu",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp-saha-notu",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "node-webhook-in",
      "name": "WhatsApp Webhook Dinleyici",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        200,
        300
      ],
      "webhookId": "whatsapp-saha-notu"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.body.message || $json.body.text || $json.body.caption || '' }}",
              "rightValue": "!",
              "operator": {
                "type": "string",
                "operation": "endsWith"
              }
            },
            {
              "id": "c2",
              "leftValue": "={{ $json.body.message || $json.body.text || $json.body.caption || '' }}",
              "rightValue": "#crm",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            },
            {
              "id": "c3",
              "leftValue": "={{ $json.body.message || $json.body.text || $json.body.caption || '' }}",
              "rightValue": "~crm",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            }
          ],
          "combinator": "or"
        }
      },
      "id": "node-filter-trigger",
      "name": "Tetikleyici Kontrolü (!, #crm veya ~crm)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// WhatsApp'tan gelen ham mesajı ve gönderen numarasını ayrıştır\nconst body = $input.item.json.body || {};\nconst rawMessage = body.message || body.text || body.caption || '';\nconst sender = body.sender || body.from || body.phone || 'WhatsApp-Plasiyer';\n\n// Mesajı CRM için hazırla\nreturn {\n  json: {\n    hamMetin: rawMessage,\n    gonderenTel: sender,\n    tetikleyici: rawMessage.endsWith('!') ? '!' : '#crm'\n  }\n};"
      },
      "id": "node-code-prep",
      "name": "Mesajı Paketle ve Temizle",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        280
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8080/api/v1/webhook/saha-notu",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Webhook-Secret",
              "value": "akillisaha-crm-secret-2026"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "node-http-backend",
      "name": "Spring Boot CRM API (POST)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        860,
        280
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ basarili: true, whatsappMesaji: $json.veri?.teyitMesaji || 'CRM kaydı oluşturuldu.' }) }}",
        "options": {}
      },
      "id": "node-respond-success",
      "name": "Teyit Mesajını Yanıtla",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1080,
        280
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ basarili: false, mesaj: 'Tetikleyici (! veya #crm) bulunamadığı için CRM aktarımı yapılmadı.' }) }}",
        "options": {}
      },
      "id": "node-respond-ignore",
      "name": "Sıradan Sohbeti Yoksay",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        640,
        460
      ]
    }
  ],
  "connections": {
    "WhatsApp Webhook Dinleyici": {
      "main": [
        [
          {
            "node": "Tetikleyici Kontrolü (!, #crm veya ~crm)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Tetikleyici Kontrolü (!, #crm veya ~crm)": {
      "main": [
        [
          {
            "node": "Mesajı Paketle ve Temizle",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Sıradan Sohbeti Yoksay",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Mesajı Paketle ve Temizle": {
      "main": [
        [
          {
            "node": "Spring Boot CRM API (POST)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Spring Boot CRM API (POST)": {
      "main": [
        [
          {
            "node": "Teyit Mesajını Yanıtla",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
